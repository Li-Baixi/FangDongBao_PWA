# 复制这个文件，改名为 .env，填上你自己的值（.env 已被 git 忽略，不会上传）
# 没填这些值时，应用自动以"本机单机模式"运行，功能照样完整。

# Supabase 项目地址（Settings -> API -> Project URL），形如 https://xxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase 匿名密钥（Settings -> API -> anon public），很长的一串
VITE_SUPABASE_ANON_KEY=

# Web Push 公钥（运行 npm run gen:vapid 生成；私钥只放 Supabase secrets）
VITE_VAPID_PUBLIC_KEY=
